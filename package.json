{
  "name": "dsh-we-need-plugin",
  "version": "4.1.1",
  "type": "module",
  "description": "稳定的 We Need 思维链，极大提升 DeepSeek V4.1 Flash 的能力。seed 使用 Kimi K3.1 Pro 原文决策轨迹；system 追加 WeNeed 推理规则，Team 外发和压缩均使用 Need/Should/Could/Must/Let's 句式，压缩以上上次工作上下文为准。支持标准模式 / goal 模式 / Team Agent 会话；Team 外发覆盖 teammate、sub-agent 与 workflow agent prompt。DSH 插件 4.1.1。",
  "license": "MIT",
  "author": "DSH We Need Plugin contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lichadai/dsh-we-need-plugin.git"
  },
  "homepage": "https://github.com/Lichadai/dsh-we-need-plugin#readme",
  "bugs": {
    "url": "https://github.com/Lichadai/dsh-we-need-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "weneed",
    "we-need",
    "deepseek",
    "seed"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./seed.txt": "./seed.txt",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "debug-tap.mjs",
    "seed.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node tests/injection.test.mjs",
    "test:package": "node tests/package.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
