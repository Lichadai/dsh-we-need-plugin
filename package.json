{
  "name": "dsh-we-need-plugin",
  "version": "2.2.0",
  "type": "module",
  "description": "稳定的 We Need 思维链，极大提升了 DeepSeek V4.1 Flash 执行计划的连贯性，减少无效思维，显著提升思维质量；适用于标准模式 DeepSeek V4.1 Flash（DSH 插件 2.2.0）。",
  "license": "MIT",
  "author": "DSH We Need Plugin contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lichadai/dsh-we-need-plugin.git"
  },
  "homepage": "https://github.com/Lichadai/dsh-we-need-plugin#readme",
  "bugs": {
    "url": "https://github.com/Lichadai/dsh-we-need-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "weneed",
    "we-need",
    "deepseek",
    "seed"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./seed.txt": "./seed.txt",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "seed.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node tests/injection.test.mjs",
    "test:package": "node tests/package.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
