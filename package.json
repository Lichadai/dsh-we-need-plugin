{
  "name": "dsh-we-need-plugin",
  "version": "4.0.0",
  "type": "module",
  "description": "稳定的 We Need 思维链，极大提升 DeepSeek V4.1 Flash 的能力。seed 仿 Kimi K3.1 Pro 的完整决策型 reasoning，包含任务复述、约束、候选 A/B、风险检查、选定与收尾；need-first 引导压缩与 Team 外发，外发消息混合 Need / Should / Could / Can / Must / Let's 句式。支持标准模式 / goal 模式 / Team Agent 会话。DSH 插件 4.0.0。",
  "license": "MIT",
  "author": "DSH We Need Plugin contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lichadai/dsh-we-need-plugin.git"
  },
  "homepage": "https://github.com/Lichadai/dsh-we-need-plugin#readme",
  "bugs": {
    "url": "https://github.com/Lichadai/dsh-we-need-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "weneed",
    "we-need",
    "deepseek",
    "seed"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./seed.txt": "./seed.txt",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "debug-tap.mjs",
    "seed.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node tests/injection.test.mjs",
    "test:package": "node tests/package.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
