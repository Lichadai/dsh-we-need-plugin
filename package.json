{
  "name": "dsh-we-need-plugin",
  "version": "0.7.0",
  "type": "module",
  "description": "DSH We Need 插件：按发给上游的 model id 里的 DeepSeek + Flash 筛选（provider 不限），注入 728/728 WeNeed assistant seed；仅适用于 DSH。",
  "license": "MIT",
  "author": "DSH We Need Plugin contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lichadai/dsh-we-need-plugin.git"
  },
  "homepage": "https://github.com/Lichadai/dsh-we-need-plugin#readme",
  "bugs": {
    "url": "https://github.com/Lichadai/dsh-we-need-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "weneed",
    "we-need",
    "deepseek",
    "seed"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./seed.txt": "./seed.txt",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "seed.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node tests/injection.test.mjs",
    "test:package": "node tests/package.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
