{
  "name": "dsh-weneed-plugin",
  "version": "0.5.0",
  "type": "module",
  "description": "DSH WeNeed Plugin: 728/728 WeNeed assistant seed for DeepSeek Flash in DeepSeek Harness.",
  "license": "MIT",
  "author": "DSH WeNeed Plugin contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lichadai/dsh-weneed-plugin.git"
  },
  "homepage": "https://github.com/Lichadai/dsh-weneed-plugin#readme",
  "bugs": {
    "url": "https://github.com/Lichadai/dsh-weneed-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "weneed",
    "we-need",
    "deepseek",
    "seed"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "seed.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node tests/injection.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
